# Voice-Enabled RAG - Environment Variables
# Copy this to .env and fill in your keys

# LLM: NVIDIA NIM (Free tier - get from https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your_key_here

# That's it! No other keys needed.
# - STT: Runs locally via Whisper (free)
# - Embeddings: sentence-transformers (free)
# - Vector DB: FAISS (free, local)
